# ZEAZ AI Command Center 3.5.0 standalone public deployment
# Copy to .env, replace the domain/email, and generate PANEL_TOKEN.

ZEAZ_VERSION=3.5.0
ZEAZ_DOMAIN=ai.example.com
ACME_EMAIL=admin@example.com
PANEL_TOKEN=replace-with-at-least-48-random-bytes

PANEL_LOG_LEVEL=INFO
PANEL_MAX_CONCURRENT_JOBS=2
PANEL_JOB_RETENTION_DAYS=30
PANEL_MAX_RETAINED_JOBS=500
PANEL_RATE_LIMIT_PER_MINUTE=120

ZEAZ_BACKUP_INTERVAL_SECONDS=86400
ZEAZ_BACKUP_RETENTION_DAYS=14
