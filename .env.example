# Web server
PANEL_HOST=127.0.0.1
PANEL_PORT=8765
# Required when PANEL_HOST is not loopback
# PANEL_TOKEN=replace-with-a-long-random-token

# Workspace access; colon-separated on Linux
# PANEL_ALLOWED_ROOTS=/home/cvsz:/srv/projects
# PANEL_ALLOW_ANY_CWD=0

# Custom executable paths are disabled by default. Executable names in PATH work without this.
# PANEL_ALLOW_ABSOLUTE_BINARIES=1

PANEL_HELP_TIMEOUT_SECONDS=20
PANEL_JOB_TIMEOUT_SECONDS=21600
PANEL_MAX_HELP_BYTES=2097152
PANEL_MAX_OUTPUT_BYTES=8388608
