# AI CLI Command Center v3.4.3 production defaults
PANEL_HOST=127.0.0.1
PANEL_PORT=8765

# Required for non-loopback binding. Generate with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PANEL_TOKEN=

# Host-header allowlist. Required when binding to 0.0.0.0 or ::
PANEL_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Workspace policy. Separate multiple paths with ':' on Linux/macOS.
PANEL_ALLOWED_ROOTS=
PANEL_ALLOW_ANY_CWD=0
PANEL_ALLOW_ABSOLUTE_BINARIES=0
PANEL_ALLOW_WORLD_WRITABLE_BINARIES=0
PANEL_ALLOW_RAW_ARGS=1

# Process environment policy.
PANEL_ALLOW_ANY_ENV=0
PANEL_ENV_ALLOWLIST=
PANEL_ENV_PREFIX_ALLOWLIST=

# Durable state and retention.
PANEL_DATABASE_PATH=
PANEL_POSTGRES_URL=
PANEL_MAX_RETAINED_JOBS=500
PANEL_JOB_RETENTION_DAYS=30
PANEL_MAX_OUTPUT_BYTES=8388608

# Runtime limits.
PANEL_MAX_CONCURRENT_JOBS=4
PANEL_JOB_TIMEOUT_SECONDS=21600
PANEL_MAX_JOB_TIMEOUT_SECONDS=86400
PANEL_HELP_TIMEOUT_SECONDS=20
PANEL_MAX_HELP_BYTES=2097152
PANEL_MAX_BODY_BYTES=2000000
PANEL_RATE_LIMIT_PER_MINUTE=240

# zai CLI routing. Control-plane 429 responses are retried with backoff.
ZAI_PROVIDER=codex
ZAI_POLL_INTERVAL=1
ZAI_RATE_LIMIT_RETRIES=8
ZAI_LOCAL_FALLBACK=1
ZAI_LOCAL_PROVIDER=ollama
ZAI_LOCAL_MODEL=qwen3-coder

# PTY and sandbox.
PANEL_USE_PTY=0
PANEL_SANDBOX_DRIVER=

# Provider rate limiting and circuit breaker.
PANEL_PROVIDER_RATE_LIMIT=
PANEL_PROVIDER_CONCURRENCY=
PANEL_CIRCUIT_BREAKER_THRESHOLD=5
PANEL_CIRCUIT_BREAKER_COOLDOWN=300

# Load shedding and health probes.
PANEL_MAX_QUEUE_DEPTH=100
PANEL_MAX_RUNNING_RATIO=0.8
PANEL_HEALTH_PROBE_INTERVAL=60
PANEL_HEALTH_PROBE_FAILURES=3

# SMTP email notifications.
PANEL_SMTP_HOST=
PANEL_SMTP_PORT=587
PANEL_SMTP_USER=
PANEL_SMTP_PASS=
PANEL_SMTP_FROM=

# Logging and reverse-proxy TLS.
PANEL_LOG_LEVEL=INFO
PANEL_LOG_FORMAT=json
PANEL_ENABLE_HSTS=0
